generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN
  SENIOR_LAWYER
  JUNIOR_LAWYER
  CLIENT
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
  APPEAL
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  ONLINE
  OFFLINE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  CASH
  CHEQUE
  BANK_TRANSFER
}

// ---------------------------------------------------------------------------
// Users & Roles
// ---------------------------------------------------------------------------
model User {
  id        String        @id @default(uuid())
  email     String        @unique
  password  String?
  firstName String?
  lastName  String?
  phone     String?
  role      Role          @default(ADMIN)
  status    GeneralStatus @default(ACTIVE)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  // Relations
  clientProfile      ClientProfile?
  lawyerProfile      LawyerProfile?
  casesAsClient      Case[]         @relation("CaseClient")
  casesAsLawyer      Case[]         @relation("CaseLawyer")
  appointmentsClient Appointment[]  @relation("AppointmentClient")
  appointmentsLawyer Appointment[]  @relation("AppointmentLawyer")
  invoices           Invoice[]
}

model ClientProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  companyName    String?
  taxId          String?
  billingAddress String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LawyerProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  specialization String?
  barNumber      String?
  experience     Int? // Years of experience
  bio            String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Core Business Logic (Cases, Appointments, Services)
// ---------------------------------------------------------------------------
model PracticeArea {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  icon        String?
  status      GeneralStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  cases Case[]
}

model Case {
  id          String       @id @default(uuid())
  caseNumber  String       @unique
  title       String
  description String?      @db.Text
  status      CaseStatus   @default(OPEN)
  priority    CasePriority @default(MEDIUM)
  courtInfo   String?
  deadline    DateTime?

  practiceAreaId String
  clientId       String
  lawyerId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  practiceArea PracticeArea @relation(fields: [practiceAreaId], references: [id])
  client       User         @relation("CaseClient", fields: [clientId], references: [id])
  lawyer       User?        @relation("CaseLawyer", fields: [lawyerId], references: [id])

  appointments Appointment[]
  invoices     Invoice[]
}

model Appointment {
  id       String  @id @default(uuid())
  clientId String
  lawyerId String?
  caseId   String?

  title       String
  description String?           @db.Text
  type        AppointmentType   @default(ONLINE)
  status      AppointmentStatus @default(REQUESTED)
  date        DateTime
  duration    Int               @default(60) // minutes
  meetingLink String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  client User  @relation("AppointmentClient", fields: [clientId], references: [id])
  lawyer User? @relation("AppointmentLawyer", fields: [lawyerId], references: [id])
  case   Case? @relation(fields: [caseId], references: [id])
}

// ---------------------------------------------------------------------------
// Billing & Payments
// ---------------------------------------------------------------------------
model Invoice {
  id        String        @id @default(uuid())
  invoiceNo String        @unique
  clientId  String
  caseId    String?
  amount    Float
  tax       Float         @default(0)
  total     Float
  status    InvoiceStatus @default(DRAFT)
  dueDate   DateTime
  notes     String?       @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  client   User      @relation(fields: [clientId], references: [id])
  case     Case?     @relation(fields: [caseId], references: [id])
  payments Payment[]
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Float
  method        PaymentMethod
  transactionId String?
  status        PaymentStatus @default(PENDING)
  date          DateTime      @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ---------------------------------------------------------------------------
// Consultations
// ---------------------------------------------------------------------------
model ConsultationRequest {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String
  serviceType String
  message     String?       @db.Text
  status      GeneralStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
